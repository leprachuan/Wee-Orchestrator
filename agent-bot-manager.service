[Unit]
Description=Wee Orchestrator — Per-Agent Bot Manager
After=network.target agent-manager-api.service
Wants=agent-manager-api.service

[Service]
Type=simple
WorkingDirectory=/opt/n8n-copilot-shim
ExecStart=/usr/bin/python3 /opt/n8n-copilot-shim/agent_bot_manager.py --config /opt/n8n-copilot-shim/agents.json --api-url https://127.0.0.1:8000 --reload-interval 30
Restart=on-failure
RestartSec=5
EnvironmentFile=/opt/n8n-copilot-shim/agent-bot-manager.env
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
