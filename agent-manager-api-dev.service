[Unit]
Description=Agent Manager API Server (Development)
After=network.target

[Service]
Type=simple
User=n8n
WorkingDirectory=/opt/n8n-copilot-shim-dev
Environment=PATH=/home/n8n/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=XDG_RUNTIME_DIR=/run/user/1000
EnvironmentFile=/opt/n8n-copilot-shim-dev/.env
Environment="API_PORT=8001"
Environment="AOA_API_URL=http://127.0.0.1:9877"
Environment="RABBITMQ_HOST=192.168.0.85"
Environment="RABBITMQ_PORT=5672"
Environment="RABBITMQ_USER=admin"
Environment="RABBITMQ_PASSWORD=nmSrvbiGOMU_b9c2M9ZqAndFjGqDQUBZ"
ExecStart=/usr/bin/python3 /opt/n8n-copilot-shim-dev/agent_manager.py --api
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
