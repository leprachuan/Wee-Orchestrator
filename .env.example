# =============================================================================
# Wee Orchestrator — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All configuration is via environment variables. No config files need to be
# edited inside the container — mount JSON configs as Docker volumes instead.
# =============================================================================

# ---------------------------------------------------------------------------
# Core Settings
# ---------------------------------------------------------------------------

# Default agent for new sessions (must exist in agents.json)
COPILOT_DEFAULT_AGENT=fosterbot

# Default model for new sessions
COPILOT_DEFAULT_MODEL=gpt-5-mini

# Default runtime for new sessions
COPILOT_DEFAULT_RUNTIME=copilot

# Command execution timeout in seconds
COMMAND_TIMEOUT=600

# ---------------------------------------------------------------------------
# API Server Configuration
# ---------------------------------------------------------------------------

# Environment identifier (DEV, PROD, DOCKER)
APP_ENV=DOCKER

# API Server port (inside container; remap with docker -p)
API_PORT=8000

# API bind address (use 0.0.0.0 in Docker to expose outside container)
API_HOST=0.0.0.0

# API authentication token (REQUIRED — generate with: openssl rand -base64 32)
AUTH_TOKEN_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# ---------------------------------------------------------------------------
# Pairing Code Settings
# ---------------------------------------------------------------------------
PAIRING_CODE_LENGTH=6
PAIRING_CODE_TTL=300

# ---------------------------------------------------------------------------
# Session Token Settings
# ---------------------------------------------------------------------------
SESSION_TOKEN_TTL=3600

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_PAIRING_REQUESTS=3
RATE_LIMIT_PAIRING_WINDOW=900
RATE_LIMIT_EXECUTE_REQUESTS=60
RATE_LIMIT_EXECUTE_WINDOW=60
RATE_LIMIT_AUTH_FAILURES=5
RATE_LIMIT_AUTH_FAILURE_WINDOW=3600

# ---------------------------------------------------------------------------
# CORS (comma-separated origins, empty = disabled)
# ---------------------------------------------------------------------------
API_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Connector API Mode
# ---------------------------------------------------------------------------
USE_API=true
API_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Task Scheduler
# ---------------------------------------------------------------------------

# Enable/disable task scheduler (true/false)
SCHEDULER_ENABLED=true

# Scheduler paths (these use /data/ inside the container for persistence)
SCHEDULER_JOBS_FILE=/data/scheduler/jobs.json
SCHEDULER_LOGS_DIR=/data/scheduler/logs/
SCHEDULER_RESULTS_DIR=/data/scheduler/results/

# Scheduler allowlist — comma-separated usernames authorized to manage scheduled tasks
SCHEDULER_ALLOWED_TELEGRAM=
SCHEDULER_ALLOWED_WEBEX=

# ---------------------------------------------------------------------------
# SSL/HTTPS (optional — mount certs as volumes)
# ---------------------------------------------------------------------------
# SSL_CERTFILE=/data/certs/cert.pem
# SSL_KEYFILE=/data/certs/key.pem
# FORCE_SSL=0

# ---------------------------------------------------------------------------
# Session Management
# ---------------------------------------------------------------------------

# Maximum sessions per user before old sessions are pruned
MAX_SESSIONS=25

# Copilot premium request quota override
RUNTIME_QUOTA_COPILOT=1500

# ---------------------------------------------------------------------------
# Model Configurations (JSON strings for runtimes without dynamic listing)
# ---------------------------------------------------------------------------
# These define which models appear in the WebUI dropdown for each runtime.
# Format: {"category": [["model_id", "Display Name", ["alias1", "alias2"]], ...]}

# CLAUDE_MODELS_JSON={"Anthropic Models":[["claude-sonnet-4","Claude Sonnet 4",["sonnet-4","sonnet"]],["claude-sonnet-4.6","Claude Sonnet 4.6",["sonnet-4.6"]],["claude-opus-4.6","Claude Opus 4.6",["opus-4.6","opus"]]]}
# GEMINI_MODELS_JSON={"Google Models":[["gemini-2.5-pro","Gemini 2.5 Pro",["gemini-pro","pro"]],["gemini-2.5-flash","Gemini 2.5 Flash",["gemini-flash","flash"]]]}
# CODEX_MODELS_JSON={"OpenAI Models":[["codex","Codex",["codex"]]]}
# DEVIN_MODELS_JSON={"Anthropic Models":[["claude-sonnet-4","Claude Sonnet 4",["sonnet"]]]}

# ---------------------------------------------------------------------------
# External Integrations (optional — only needed if using bot connectors)
# ---------------------------------------------------------------------------

# RabbitMQ (for WebEx bot connector)
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_PORT=5672
# RABBITMQ_USER=admin
# RABBITMQ_PASSWORD=CHANGE_ME
# RABBITMQ_QUEUE=webex
# RABBITMQ_VHOST=/

# Telegram Bot (token goes in telegram_config.json volume mount)
# WebEx Bot (token goes in webex_config.json volume mount)
