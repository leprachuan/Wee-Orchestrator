# N8N Copilot Shim - Environment Configuration

# Default agent for new sessions
COPILOT_DEFAULT_AGENT=orchestrator

# Default model for new sessions
COPILOT_DEFAULT_MODEL=gpt-5-mini

# Default runtime for new sessions
COPILOT_DEFAULT_RUNTIME=copilot

# Command execution timeout in seconds
COMMAND_TIMEOUT=600

# --- API Server Configuration ---

# Environment identifier
APP_ENV=DEV

# API Server (prod runs on 8000, dev on 8001)
API_HOST=127.0.0.1,100.124.186.75
API_PORT=8001
API_SHARED_KEY=your-shared-key-here

# Pairing Code Settings
PAIRING_CODE_LENGTH=6
PAIRING_CODE_TTL=300

# Session Token Settings
SESSION_TOKEN_TTL=3600

# Rate Limiting
RATE_LIMIT_PAIRING_REQUESTS=3
RATE_LIMIT_PAIRING_WINDOW=900
RATE_LIMIT_EXECUTE_REQUESTS=60
RATE_LIMIT_EXECUTE_WINDOW=60
RATE_LIMIT_AUTH_FAILURES=5
RATE_LIMIT_AUTH_FAILURE_WINDOW=3600

# CORS (comma-separated origins, empty = disabled)
API_CORS_ORIGINS=

# Connector API Mode
USE_API=true
API_URL=http://127.0.0.1:8001

# Task Scheduler feature flag (true/false)
SCHEDULER_ENABLED=true

# Scheduler paths (dev-specific)
SCHEDULER_JOBS_FILE=/opt/n8n-copilot-shim-dev/.task-scheduler/jobs.json
SCHEDULER_LOGS_DIR=/opt/n8n-copilot-shim-dev/.task-scheduler/logs/
SCHEDULER_RESULTS_DIR=/opt/n8n-copilot-shim-dev/.task-scheduler/results/

# Session Management
# Maximum sessions per user before old sessions are pruned
MAX_SESSIONS=25

# --- Copilot Premium Request Quota ---
# Plan: free=50, pro=300, pro+=1500, business=300, enterprise=1000
COPILOT_PLAN=pro+

# --- Audio Transcription ---
# Backend: "openai" (cloud), "local" (faster-whisper), "auto" (local first, fallback openai)
TRANSCRIPTION_BACKEND=auto
# Local whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=base
# OpenAI API key (used for Whisper API + image generation)
OPENAI_API_KEY=your-openai-key-here

# SSL/HTTPS (self-signed for dev)
SSL_CERTFILE=/path/to/cert.pem
SSL_KEYFILE=/path/to/key.pem

# Scheduler allowlist — comma-separated usernames authorized to manage scheduled tasks
SCHEDULER_ALLOWED_TELEGRAM=vtflip
SCHEDULER_ALLOWED_WEBEX=flipkey@cisco.com
