# =============================================================================
# Wee Orchestrator — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Bot connectors (Telegram, WebEx) start automatically if credentials are set.
# =============================================================================

# --- Core Settings ---
COPILOT_DEFAULT_AGENT=assistant
COPILOT_DEFAULT_MODEL=gpt-5-mini
COPILOT_DEFAULT_RUNTIME=copilot
COMMAND_TIMEOUT=600

# --- API Server ---
APP_ENV=DOCKER
API_PORT=8000
API_HOST=0.0.0.0
AUTH_TOKEN_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# --- Pairing & Sessions ---
PAIRING_CODE_LENGTH=6
PAIRING_CODE_TTL=300
# Sliding window in seconds, refreshed on every authenticated request.
SESSION_TOKEN_TTL=2592000
# Hard cap in seconds from token creation, regardless of activity.
SESSION_TOKEN_ABSOLUTE_TTL=15552000
MAX_SESSIONS=25

# --- Rate Limiting ---
RATE_LIMIT_PAIRING_REQUESTS=3
RATE_LIMIT_PAIRING_WINDOW=900
RATE_LIMIT_EXECUTE_REQUESTS=60
RATE_LIMIT_EXECUTE_WINDOW=60
RATE_LIMIT_AUTH_FAILURES=5
RATE_LIMIT_AUTH_FAILURE_WINDOW=3600

# --- CORS ---
API_CORS_ORIGINS=

# --- Internal API ---
USE_API=true
API_URL=http://127.0.0.1:8000

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_JOBS_FILE=/data/scheduler/jobs.json
SCHEDULER_LOGS_DIR=/data/scheduler/logs/
SCHEDULER_RESULTS_DIR=/data/scheduler/results/

# --- SSL (optional) ---
# SSL_CERTFILE=/data/certs/cert.pem
# SSL_KEYFILE=/data/certs/key.pem
# FORCE_SSL=0

# --- Quotas ---
RUNTIME_QUOTA_COPILOT=1500

# =============================================================================
# Telegram Bot (optional)
# =============================================================================
# Set TELEGRAM_BOT_TOKEN to enable the Telegram bot connector.
# The bot will start automatically when this is set.
# Alternatively, mount a telegram_config.json volume (see docker-compose.yml).
# TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# =============================================================================
# WebEx Bot (optional)
# =============================================================================
# Set all four variables below to enable the WebEx bot connector.
# The bot will start automatically when WEBEX_BOT_TOKEN + RABBITMQ_PASSWORD are set.
# Alternatively, mount a webex_config.json volume (see docker-compose.yml).
# WEBEX_BOT_TOKEN=your_webex_bot_token
# RABBITMQ_HOST=your_rabbitmq_host
# RABBITMQ_PORT=5672
# RABBITMQ_USER=admin
# RABBITMQ_PASSWORD=your_rabbitmq_password
# RABBITMQ_QUEUE=webex

# =============================================================================
# Docker Deployment (used by docker-setup.sh)
# =============================================================================
# Generate with: openssl rand -base64 32
AUTH_TOKEN_SECRET=CHANGE_ME
# Runtime to use (copilot, claude, gemini, opencode, codex)
COPILOT_DEFAULT_RUNTIME=copilot
# Optional Telegram bot token
TELEGRAM_BOT_TOKEN=

# =============================================================================
# AI Runtime API Keys (optional)
# =============================================================================
# All runtime CLIs are pre-installed in the Docker image.
# Set the API key for each runtime you want to use.
# Copilot requires interactive `copilot auth login` — see DOCKER_QUICKSTART.md.
#
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=sk-your-openai-key-here

# =============================================================================
# Ollama Configuration
# =============================================================================
# Ollama host and port for wee_runtime.py and wee CLI
# Defaults to Kubuntu at 192.168.1.101:11434
OLLAMA_HOST=192.168.1.101
OLLAMA_PORT=11434

# =============================================================================
# LM Studio Configuration
# =============================================================================
# LM Studio API endpoint (for local inference)
LMSTUDIO_HOST=localhost
LMSTUDIO_PORT=1234

# =============================================================================
# Wee TUI (terminal user interface)
# =============================================================================
# Run: cd /opt/n8n-copilot-shim && python3 -m tui.app
WEE_API_URL=https://127.0.0.1:8000
WEE_AUTH_TOKEN=
WEE_USER_ID=
WEE_VERIFY_SSL=false
WEE_CHANNEL=tui
WEE_TUI_THEME=default
