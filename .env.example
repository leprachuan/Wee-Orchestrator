# N8N Copilot Shim - Environment Configuration
# Copy this file to .env and customize for your environment

# Default agent for new sessions
# Options: devops, family, projects, orchestrator, or any configured agent
COPILOT_DEFAULT_AGENT=orchestrator

# Default model for new sessions
# Examples: gpt-5-mini, gpt-5, claude-sonnet, gemini-1.5-flash
COPILOT_DEFAULT_MODEL=gpt-5-mini

# Default runtime for new sessions
# Options: copilot, opencode, claude, gemini, codex
COPILOT_DEFAULT_RUNTIME=copilot

# Command execution timeout in seconds (default: 300 / 5 minutes)
# Applies to all runtime CLI commands (copilot, opencode, claude, gemini, codex)
# Increase this value for long-running operations (e.g., 600 for 10 minutes)
# Minimum recommended: 60 seconds
COMMAND_TIMEOUT=600

# --- API Server Configuration ---

# Environment identifier (DEV or PROD)
APP_ENV=DEV

# API Server
API_HOST=127.0.0.1
API_PORT=8001
API_SHARED_KEY=change_me_to_a_secure_random_string

# Pairing Code Settings
PAIRING_CODE_LENGTH=6
PAIRING_CODE_TTL=300

# Session Token Settings
SESSION_TOKEN_TTL=3600

# Rate Limiting
RATE_LIMIT_PAIRING_REQUESTS=3
RATE_LIMIT_PAIRING_WINDOW=900
RATE_LIMIT_EXECUTE_REQUESTS=60
RATE_LIMIT_EXECUTE_WINDOW=60
RATE_LIMIT_AUTH_FAILURES=5
RATE_LIMIT_AUTH_FAILURE_WINDOW=3600

# CORS (comma-separated origins, empty = disabled)
API_CORS_ORIGINS=

# Connector API Mode
USE_API=false
API_URL=http://127.0.0.1:8001

# Task Scheduler feature flag — set to false to disable the scheduler API and WebUI panel
SCHEDULER_ENABLED=true

# Session Management
# Maximum sessions per user before old sessions are pruned
MAX_SESSIONS=100
